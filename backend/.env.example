# Copie para .env e preencha. Nunca versione o .env.

# Supabase > Project Settings > Database > Connection string.
# Runtime da API (pooler em modo transaction, porta 6543):
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres"
# Migrations do Prisma (conexão direta ou pooler em modo session, porta 5432):
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# Segredo do JWT de sessão do admin (mín. 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Duração da sessão do admin, em segundos (padrão: 8h).
SESSAO_DURACAO_SEGUNDOS=28800

PORT=3000
NODE_ENV=development

# --- Contas de cliente ---
# Duração da sessão do cliente, em segundos (padrão: 30 dias).
SESSAO_CLIENTE_DURACAO_SEGUNDOS=2592000
# Endereço do site; usado nos links enviados por e-mail. Obrigatório em produção.
FRONTEND_URL="http://localhost:5173"

# E-mail: "log" (dev — só imprime no console, inclusive o código) ou "resend".
EMAIL_PROVEDOR=log
# Com resend: remetente de um domínio verificado no Resend e a chave da API.
EMAIL_REMETENTE="Barbearia Novo Estilo <nao-responda@seu-dominio.com.br>"
RESEND_API_KEY=""

# WhatsApp: "log" (dev) ou "cloud_api" (WhatsApp Cloud API da Meta).
WHATSAPP_PROVEDOR=log
# Com cloud_api: token permanente (usuário de sistema), id do número e template
# de autenticação aprovado (com botão "copiar código").
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_VERIFICACAO=""
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
WHATSAPP_API_VERSAO=v23.0
