// Schema do banco (Supabase PostgreSQL). Constraints CHECK, triggers e RLS ficam nas migrations SQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PapelAdmin {
  ADMIN
  SUPPORT

  @@map("papel_admin")
}

/// Usuários com acesso ao painel admin: o dono (ADMIN) e o desenvolvedor para suporte (SUPPORT).
model UsuarioAdmin {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                   String
  /// Sempre minúsculo (garantido por CHECK no banco).
  email                  String                    @unique
  senhaHash              String                    @map("senha_hash")
  papel                  PapelAdmin                @default(ADMIN)
  ativo                  Boolean                   @default(true)
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Atualizado pelo trigger trg_usuarios_admin_updated_at.
  updatedAt              DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  agendamentosCancelados Agendamento[]
  solicitacoesDecididas  SolicitacaoCancelamento[]
  reagendamentosVistos   Reagendamento[]

  @@map("usuarios_admin")
}

/// Clientes do site. Todo cliente tem conta (e-mail + senha e/ou Google); reservas manuais do admin não criam cliente.
model Cliente {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                 String
  /// E.164 (ex.: +5544999999999), normalizado por clientes/telefone.ts e garantido por CHECK.
  telefone             String         @unique
  /// Sempre minúsculo (garantido por CHECK no banco).
  email                String         @unique
  /// NULL em conta só-Google. Nunca selecionar em respostas da API.
  senhaHash            String?        @map("senha_hash")
  googleSub            String?        @unique @map("google_sub")
  emailVerificadoEm    DateTime?      @map("email_verificado_em") @db.Timestamptz(6)
  telefoneVerificadoEm DateTime?      @map("telefone_verificado_em") @db.Timestamptz(6)
  /// Vai no JWT; incrementar invalida todas as sessões emitidas antes.
  versaoSessao         Int            @default(0) @map("versao_sessao")
  termosVersaoAceita   String         @map("termos_versao_aceita")
  termosAceitosEm      DateTime       @map("termos_aceitos_em") @db.Timestamptz(6)
  ultimoLoginEm        DateTime?      @map("ultimo_login_em") @db.Timestamptz(6)
  ativo                Boolean        @default(true)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Atualizado pelo trigger trg_clientes_updated_at.
  updatedAt            DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  tokens               TokenCliente[]
  agendamentos         Agendamento[]
  avaliacoes           Avaliacao[]

  @@map("clientes")
}

enum TipoTokenCliente {
  verificar_email
  verificar_telefone
  recuperar_senha

  @@map("tipo_token_cliente")
}

/// Códigos de verificação e tokens de recuperação de senha. Só o HMAC do valor é guardado.
model TokenCliente {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId  String           @map("cliente_id") @db.Uuid
  tipo       TipoTokenCliente
  tokenHash  String           @map("token_hash")
  expiraEm   DateTime         @map("expira_em") @db.Timestamptz(6)
  /// Preenchido quando o token é usado ou substituído por um mais novo.
  usadoEm    DateTime?        @map("usado_em") @db.Timestamptz(6)
  tentativas Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  cliente    Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([clienteId, tipo, createdAt])
  @@index([tipo, tokenHash])
  @@map("tokens_clientes")
}

/// Catálogo de serviços. Nunca apagado: "remover" é ativo = false (agendamentos referenciam por FK).
/// O índice único em lower(trim(nome)) vive só na migration (Prisma não modela índice de expressão).
model Servico {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome           String
  descricao      String?
  preco          Decimal       @db.Decimal(10, 2)
  duracaoMinutos Int           @map("duracao_minutos")
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Atualizado pelo trigger trg_servicos_updated_at.
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  agendamentos   Agendamento[]

  @@map("servicos")
}

/// Configurações da barbearia: linha única (id sempre true, garantido por CHECK). Horários em 'HH:mm'
/// (ordem e formato garantidos por CHECK). Ver migration 20261013160000_configuracoes.
model Configuracao {
  id                Boolean  @id @default(true)
  nome              String
  telefone          String
  endereco          String
  manhaInicio       String   @map("manha_inicio")
  manhaFim          String   @map("manha_fim")
  tardeInicio       String   @map("tarde_inicio")
  tardeFim          String   @map("tarde_fim")
  antecedenciaHoras Int      @default(2) @map("antecedencia_horas")
  janelaDias        Int      @default(90) @map("janela_dias")
  /// Dias de trabalho da semana (1 = segunda … 7 = domingo), sem repetição. Os demais são folga semanal.
  diasTrabalho      Int[]    @default([1, 2, 3, 4, 5, 6]) @map("dias_trabalho")
  /// Atualizado pelo trigger trg_configuracoes_updated_at.
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("configuracoes")
}

/// Exceções do dono ao calendário (domingos e feriados fecham por padrão, calculados no backend):
/// aberto = false fecha um dia comum; aberto = true desbloqueia um domingo/feriado. Ver migration 20261013170000_dias_especiais.
model DiaEspecial {
  data      DateTime @id @db.Date
  aberto    Boolean
  motivo    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Atualizado pelo trigger trg_dias_especiais_updated_at.
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("dias_especiais")
}

enum StatusAgendamento {
  agendado
  concluido
  cancelado

  @@map("status_agendamento")
}

enum FormaPagamento {
  pix
  cartao
  presencial

  @@map("forma_pagamento")
}

enum StatusSolicitacaoCancelamento {
  pendente
  aprovada
  recusada

  @@map("status_solicitacao_cancelamento")
}

/// Agendamento do site (clienteId) ou reserva manual do admin (nomeAvulso) — exatamente um (CHECK).
/// A garantia contra dupla reserva é o EXCLUDE agendamentos_sem_sobreposicao (só na migration; Prisma não modela).
model Agendamento {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId      String?           @map("cliente_id") @db.Uuid
  nomeAvulso     String?           @map("nome_avulso")
  servicoId      String            @map("servico_id") @db.Uuid
  inicio         DateTime          @db.Timestamptz(6)
  /// Calculado pelo trigger (inicio + duração); o valor enviado na escrita é sobrescrito.
  fim            DateTime          @default(now()) @db.Timestamptz(6)
  duracaoMinutos Int               @map("duracao_minutos")
  preco          Decimal           @db.Decimal(10, 2)
  pagamento      FormaPagamento    @default(presencial)
  status         StatusAgendamento @default(agendado)
  canceladoEm    DateTime?         @map("cancelado_em") @db.Timestamptz(6)
  canceladoPor   String?           @map("cancelado_por") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Atualizado pelo trigger trg_agendamentos_updated_at.
  updatedAt      DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)

  cliente        Cliente?                  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  servico        Servico                   @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  cancelador     UsuarioAdmin?             @relation(fields: [canceladoPor], references: [id], onDelete: Restrict)
  reagendamentos Reagendamento[]
  solicitacoes   SolicitacaoCancelamento[]

  @@index([inicio])
  @@index([clienteId, inicio])
  @@index([servicoId])
  @@map("agendamentos")
}

enum OrigemReagendamento {
  cliente
  admin

  @@map("origem_reagendamento")
}

/// Histórico de reagendamentos (um registro por mudança de horário).
/// Reagendamento do cliente não precisa de aprovação: vira notificação para o barbeiro até ele marcar como visto.
model Reagendamento {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agendamentoId  String              @map("agendamento_id") @db.Uuid
  inicioAnterior DateTime            @map("inicio_anterior") @db.Timestamptz(6)
  inicioNovo     DateTime            @map("inicio_novo") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  origem         OrigemReagendamento @default(cliente)
  /// Quando o barbeiro viu a notificação. Nulo = notificação pendente (só para origem cliente; CHECK na migration).
  vistoEm        DateTime?           @map("visto_em") @db.Timestamptz(6)
  vistoPor       String?             @map("visto_por") @db.Uuid
  agendamento    Agendamento         @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)
  visor          UsuarioAdmin?       @relation(fields: [vistoPor], references: [id], onDelete: Restrict)

  @@index([agendamentoId, createdAt])
  @@map("reagendamentos")
}

/// O cliente pede o cancelamento (motivo obrigatório); o admin aprova ou recusa.
/// No máximo uma pendente por agendamento (índice único parcial na migration).
model SolicitacaoCancelamento {
  id            String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agendamentoId String                        @map("agendamento_id") @db.Uuid
  motivo        String
  status        StatusSolicitacaoCancelamento @default(pendente)
  resposta      String?
  decididoEm    DateTime?                     @map("decidido_em") @db.Timestamptz(6)
  decididoPor   String?                       @map("decidido_por") @db.Uuid
  createdAt     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Atualizado pelo trigger trg_solicitacoes_cancelamento_updated_at.
  updatedAt     DateTime                      @default(now()) @map("updated_at") @db.Timestamptz(6)
  agendamento   Agendamento                   @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)
  decisor       UsuarioAdmin?                 @relation(fields: [decididoPor], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([agendamentoId])
  @@map("solicitacoes_cancelamento")
}

/// Avaliação do cliente (nota + comentário + até 3 fotos), exibida no site assim que enviada.
/// Uma ativa por cliente (índice único parcial na migration); `publicada` é o "ocultar" do painel;
/// `removidaEm` é a exclusão feita pelo próprio cliente (apaga as fotos). Ver migration 20261016130000_avaliacoes.
model Avaliacao {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId  String          @map("cliente_id") @db.Uuid
  nota       Int             @db.SmallInt
  comentario String
  publicada  Boolean         @default(true)
  removidaEm DateTime?       @map("removida_em") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Atualizado pelo trigger trg_avaliacoes_updated_at.
  updatedAt  DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  cliente    Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fotos      AvaliacaoFoto[]

  @@map("avaliacoes")
}

/// Fotos de uma avaliação (posição 1 a 3). O arquivo fica no armazenamento (Supabase Storage); aqui só o caminho.
model AvaliacaoFoto {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  avaliacaoId String    @map("avaliacao_id") @db.Uuid
  posicao     Int       @db.SmallInt
  caminho     String    @unique
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  avaliacao   Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@unique([avaliacaoId, posicao])
  @@map("avaliacao_fotos")
}
