# Copie para .env e preencha. Nunca versione o .env.
# O pagamento online (Mercado Pago) não usa variável aqui: a chave pública vem do backend
# (MERCADOPAGO_PUBLIC_KEY, via GET /api/pagamentos/config).

# Login com Google: o mesmo ID do cliente OAuth (Web) do GOOGLE_CLIENT_ID do backend. Não é segredo.
# Vazio = o botão "Entrar com o Google" não aparece.
VITE_GOOGLE_CLIENT_ID=""

# Pix estático para o barbeiro cobrar no salão (painel > Agenda > botão Pix) e para o site quando o
# pagamento online está desligado. Opcional.
VITE_PIX_CHAVE=""
VITE_PIX_NOME="Barbearia Novo Estilo"
VITE_PIX_CIDADE="CURITIBA"

# TEMPORÁRIO: false não pede verificação de e-mail/WhatsApp para agendar/avaliar.
# Tem que bater com EXIGIR_CONTA_VERIFICADA do backend. Nunca false em produção.
VITE_EXIGIR_CONTA_VERIFICADA=true
